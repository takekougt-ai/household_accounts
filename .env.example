# GCP / BigQuery
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=household_accounts
BQ_TABLE=amex_transactions

# Gemini API (categorization)
GEMINI_API_KEY=AIzaSy-xxxx
# Flash is recommended for this task: categorization is a simple
# classification job and Flash is far cheaper than Pro at equivalent
# accuracy for this use case. Override if you want a stronger model.
GEMINI_MODEL=gemini-2.5-flash

# MoneyForward ME (unofficial login flow, personal use only)
MONEYFORWARD_EMAIL=you@example.com
MONEYFORWARD_PASSWORD=xxxx
# Restrict fetch to the MF sub-account that holds the Amex card, if known.
MONEYFORWARD_ACCOUNT_ID=
